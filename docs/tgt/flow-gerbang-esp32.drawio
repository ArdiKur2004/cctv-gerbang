<mxfile host="app.diagrams.net" agent="Claude Code">
  <diagram id="flow-gerbang-esp32" name="Alur gerbang CCTV + ESP32">
    <mxGraphModel dx="8838" dy="6844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="judul" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Alur gerbang CCTV: kamera → PC lokal → server → ESP32 → relay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Satu kamera CCTV 2K, router, PC lokal di pos satpam, server TGT + mesin baca plat, ESP32 + relay ke motor gerbang&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="1200" y="-2180" as="geometry" />
        </mxCell>
        <mxCell id="lajur-kamera" parent="1" style="swimlane;startSize=34;fontStyle=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#fafafa;container=0;collapsible=0;" value="Kamera CCTV" vertex="1">
          <mxGeometry height="2020" width="200" y="-2110" as="geometry" />
        </mxCell>
        <mxCell id="lajur-pc" parent="1" style="swimlane;startSize=34;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9ff;container=0;collapsible=0;" value="PC lokal (pos satpam)" vertex="1">
          <mxGeometry height="2020" width="280" x="200" y="-2110" as="geometry" />
        </mxCell>
        <mxCell id="lajur-server" parent="1" style="swimlane;startSize=34;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fbf8fc;container=0;collapsible=0;" value="Server (TGT + mesin baca plat)" vertex="1">
          <mxGeometry height="2020" width="580" x="480" y="-2110" as="geometry" />
        </mxCell>
        <mxCell id="lajur-esp" parent="1" style="swimlane;startSize=34;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;container=0;collapsible=0;" value="ESP32 + relay + motor gerbang" vertex="1">
          <mxGeometry height="2020" width="260" x="1060" y="-2110" as="geometry" />
        </mxCell>
        <mxCell id="lajur-satpam" parent="1" style="swimlane;startSize=34;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f7fbf6;container=0;collapsible=0;" value="Satpam" vertex="1">
          <mxGeometry height="2020" width="280" x="1320" y="-2110" as="geometry" />
        </mxCell>
        <mxCell id="k1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="Kamera CCTV 2K merekam terus&lt;br&gt;(aliran RTSP)" vertex="1">
          <mxGeometry height="60" width="160" x="20" y="-2040" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Ambil bingkai dari kamera lewat router&lt;br&gt;(± 1 gambar per detik)" vertex="1">
          <mxGeometry height="60" width="220" x="230" y="-2040" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Ada gerak /&lt;br&gt;kendaraan?" vertex="1">
          <mxGeometry height="100" width="180" x="250" y="-1950" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Server&lt;br&gt;terjangkau?" vertex="1">
          <mxGeometry height="100" width="180" x="250" y="-1820" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Kirim gambar ke server&lt;br&gt;(+ nomor gerbang dan jam)" vertex="1">
          <mxGeometry height="60" width="220" x="230" y="-1690" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Feedback ke PC lokal&lt;/b&gt;&lt;br&gt;Layar satpam menampilkan putusan, alasan, dan foto (dengan kata dan bentuk, bukan warna saja)" vertex="1">
          <mxGeometry height="80" width="220" x="230" y="-790" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Mesin baca: cari kendaraan → cari plat → baca huruf, dan kenali jenis kendaraan" vertex="1">
          <mxGeometry height="60" width="240" x="560" y="-1690" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Bingkai lanjutan dari kedatangan yang sama (≤ 20 detik)?" vertex="1">
          <mxGeometry height="110" width="220" x="570" y="-1600" as="geometry" />
        </mxCell>
        <mxCell id="s2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#f5f5f5;strokeColor=#9673a6;dashed=1;" value="Pakai putusan bingkai pertama. Tidak membuat kejadian baru dan tidak mengirim perintah ulang (K75)" vertex="1">
          <mxGeometry height="70" width="200" x="840" y="-1580" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Plat&lt;br&gt;terbaca?" vertex="1">
          <mxGeometry height="100" width="200" x="580" y="-1460" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Bacaan yakin?&lt;br&gt;(atau ragu 1–2 posisi dan cocok tepat satu plat, K46)" vertex="1">
          <mxGeometry height="120" width="220" x="570" y="-1330" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Terdaftar?&lt;br&gt;(penghuni, atau tamu dengan undangan aktif)" vertex="1">
          <mxGeometry height="110" width="220" x="570" y="-1180" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Status cocok dengan arah?&lt;br&gt;(masuk saat di luar, keluar saat di dalam)" vertex="1">
          <mxGeometry height="110" width="220" x="570" y="-1040" as="geometry" />
        </mxCell>
        <mxCell id="s6b" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Arah?" vertex="1">
          <mxGeometry height="100" width="160" x="860" y="-1035" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Putusan: PANGGIL SATPAM&lt;/b&gt;&lt;br&gt;gerbang tidak dibuka" vertex="1">
          <mxGeometry height="70" width="200" x="840" y="-1220" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Putusan: BUKA&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="200" x="580" y="-890" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Catat kejadian&lt;/b&gt;&lt;br&gt;plat, jenis, status MASUK / KELUAR, jam masuk, tamu siapa dan siapa pengundangnya, putusan dan alasannya, foto" vertex="1">
          <mxGeometry height="90" width="240" x="560" y="-800" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Putusan&lt;br&gt;BUKA?" vertex="1">
          <mxGeometry height="100" width="180" x="590" y="-670" as="geometry" />
        </mxCell>
        <mxCell id="s11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Catat: gerbang terbuka + jam" vertex="1">
          <mxGeometry height="60" width="200" x="580" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="s12" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" value="Selesai" vertex="1">
          <mxGeometry height="50" width="120" x="620" y="-220" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="ESP32 menerima perintah &lt;b&gt;BUKA&lt;/b&gt;&lt;br&gt;(hanya buka, tidak pernah tutup)" vertex="1">
          <mxGeometry height="80" width="200" x="1090" y="-660" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Relay menyala sesaat (± 1 detik)" vertex="1">
          <mxGeometry height="60" width="200" x="1090" y="-540" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Motor gerbang membuka. Gerbang ditutup oleh pengendali motor + fotosel, bukan oleh sistem ini" vertex="1">
          <mxGeometry height="80" width="200" x="1090" y="-440" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Kirim konfirmasi &quot;sudah dibuka&quot; ke server" vertex="1">
          <mxGeometry height="60" width="200" x="1090" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="st0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Server tak terjangkau: gerbang &lt;b&gt;tidak&lt;/b&gt; dibuka otomatis. Satpam menangani; catatan diantre di PC lokal lalu disusulkan (mode luring)" vertex="1">
          <mxGeometry height="100" width="220" x="1350" y="-1820" as="geometry" />
        </mxCell>
        <mxCell id="st1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="Notifikasi ke satpam (HP + layar), dengan foto dan alasan" vertex="1">
          <mxGeometry height="70" width="220" x="1350" y="-530" as="geometry" />
        </mxCell>
        <mxCell id="st2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="Satpam&lt;br&gt;mengizinkan?" vertex="1">
          <mxGeometry height="100" width="180" x="1370" y="-420" as="geometry" />
        </mxCell>
        <mxCell id="st3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="Buka manual: dicatat &quot;dibuka_satpam&quot;, bukan putusan mesin" vertex="1">
          <mxGeometry height="70" width="220" x="1350" y="-290" as="geometry" />
        </mxCell>
        <mxCell id="st4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Gerbang tetap tertutup; dicatat ditolak" vertex="1">
          <mxGeometry height="60" width="220" x="1350" y="-180" as="geometry" />
        </mxCell>
        <mxCell id="aturan" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Aturan keselamatan yang dipegang alur ini&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Sistem hanya memberi perintah &lt;b&gt;BUKA&lt;/b&gt;, tidak pernah TUTUP. Pengaman gerbang (fotosel) tetap dipakai.&lt;br&gt;• Ragu = tidak membuka. Ragu 1–2 posisi boleh dibuka hanya bila cocok tepat satu plat; lebih dari 2 posisi ragu selalu memanggil satpam (K46).&lt;br&gt;• Status janggal: MASUK tetap dibuka + notifikasi, KELUAR memanggil satpam (K73).&lt;br&gt;• Jenis dan warna kendaraan hanya dicatat, tidak pernah menahan gerbang (K55, K63).&lt;br&gt;• Satu kendaraan = satu kedatangan dalam 20 detik (K75).&lt;br&gt;• Semua data disimpan (K74). Plat + jam = data pribadi (UU PDP).&lt;br&gt;• ESP32 tidak mengolah video; ia hanya menerima perintah dan menyalakan relay.&lt;br&gt;• Sampai Fase 5, relay hanya menyalakan lampu uji. Gerbang sungguhan hanya digerakkan dengan owner hadir." vertex="1">
          <mxGeometry height="330" width="460" x="10" y="-630" as="geometry" />
        </mxCell>
