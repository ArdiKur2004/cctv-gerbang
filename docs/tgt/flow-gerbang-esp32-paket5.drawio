          <mxGeometry height="100" width="180" x="290" y="-960" as="geometry" />
        </mxCell>
        <mxCell id="p8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Lapor ke server: gerbang sudah terbuka" vertex="1">
          <mxGeometry height="60" width="220" x="270" y="-580" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Nilai tiap gambar (5 kali)&lt;/b&gt;&lt;br&gt;PLAT · JENIS · WARNA" vertex="1">
          <mxGeometry height="80" width="240" x="610" y="-1920" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Bandingkan 5 hasil&lt;/b&gt;&lt;br&gt;plat yang paling sering sama; jenis dan warna terbanyak" vertex="1">
          <mxGeometry height="80" width="240" x="610" y="-1810" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=9;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Plat sepakat?&lt;br&gt;(mis. ≥ 3 dari 5 sama; angka pastinya dari uji. Ragu 1–2 posisi hanya bila cocok tepat satu plat, K46)" vertex="1">
          <mxGeometry height="130" width="240" x="610" y="-1705" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Terdaftar?&lt;br&gt;(penghuni, atau tamu dengan undangan aktif)" vertex="1">
          <mxGeometry height="110" width="220" x="620" y="-1555" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Status cocok dengan arah?&lt;br&gt;(masuk saat di luar, keluar saat di dalam)" vertex="1">
          <mxGeometry height="110" width="220" x="620" y="-1420" as="geometry" />
        </mxCell>
        <mxCell id="s6b" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Arah?" vertex="1">
          <mxGeometry height="100" width="160" x="900" y="-1415" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Putusan: PANGGIL SATPAM&lt;/b&gt;&lt;br&gt;gerbang tidak dibuka" vertex="1">
          <mxGeometry height="70" width="200" x="880" y="-1600" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Putusan: BUKA&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="200" x="630" y="-1270" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="Cocokkan JENIS dan WARNA dengan data pendaftaran. Bila beda hanya &lt;b&gt;ditandai&lt;/b&gt;; putusan tidak berubah (K55, K63)" vertex="1">
          <mxGeometry height="75" width="240" x="610" y="-1195" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Catat kejadian&lt;/b&gt;&lt;br&gt;status MASUK / KELUAR, jam masuk, tamu siapa dan siapa pengundangnya, plat, jenis, warna, putusan dan alasannya, 5 foto" vertex="1">
          <mxGeometry height="90" width="240" x="610" y="-1090" as="geometry" />
        </mxCell>
        <mxCell id="s11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Catat: gerbang terbuka + jam" vertex="1">
          <mxGeometry height="60" width="200" x="630" y="-480" as="geometry" />
        </mxCell>
        <mxCell id="s12" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" value="Selesai" vertex="1">
          <mxGeometry height="50" width="120" x="670" y="-390" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="ESP32 menerima perintah &lt;b&gt;BUKA&lt;/b&gt; dari PC lokal (hanya buka, tidak pernah tutup)" vertex="1">
          <mxGeometry height="70" width="200" x="1110" y="-950" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Relay menyala sesaat (± 1 detik)" vertex="1">
          <mxGeometry height="60" width="200" x="1110" y="-800" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Motor gerbang membuka. Gerbang ditutup oleh pengendali motor + fotosel, bukan oleh sistem ini" vertex="1">
          <mxGeometry height="80" width="200" x="1110" y="-700" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Kirim konfirmasi &quot;sudah dibuka&quot; ke PC lokal" vertex="1">
          <mxGeometry height="60" width="200" x="1110" y="-580" as="geometry" />
        </mxCell>
        <mxCell id="st0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Server tak terjangkau: gerbang &lt;b&gt;tidak&lt;/b&gt; dibuka otomatis. Satpam menangani; catatan diantre di PC lokal lalu disusulkan (mode luring)" vertex="1">
          <mxGeometry height="100" width="220" x="1360" y="-2040" as="geometry" />
        </mxCell>
        <mxCell id="st1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="Notifikasi ke satpam (HP + layar), dengan 5 foto dan alasan" vertex="1">
          <mxGeometry height="70" width="220" x="1360" y="-790" as="geometry" />
        </mxCell>
        <mxCell id="st2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="Satpam&lt;br&gt;mengizinkan?" vertex="1">
          <mxGeometry height="100" width="180" x="1380" y="-680" as="geometry" />
        </mxCell>
        <mxCell id="st3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="Buka manual dari PC lokal: dicatat &quot;dibuka_satpam&quot;, bukan putusan mesin" vertex="1">
          <mxGeometry height="70" width="220" x="1360" y="-550" as="geometry" />
        </mxCell>
        <mxCell id="st4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Gerbang tetap tertutup; dicatat ditolak" vertex="1">
          <mxGeometry height="60" width="220" x="1360" y="-440" as="geometry" />
        </mxCell>
        <mxCell id="aturan" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Aturan dan batas yang dipegang alur ini&lt;/b&gt;&lt;br&gt;• Sistem hanya memberi perintah &lt;b&gt;BUKA&lt;/b&gt;, tidak pernah TUTUP. Gerbang ditutup pengendali motor + fotosel.&lt;br&gt;• Ragu = tidak membuka. Lebih dari 2 posisi ragu selalu memanggil satpam (K46). Status janggal: MASUK dibuka + notifikasi, KELUAR memanggil satpam (K73).&lt;br&gt;• PLAT yang menentukan buka. JENIS dan WARNA hanya dicatat dan ditandai, tidak pernah menahan gerbang (K55, K63). &lt;b&gt;Warna mobil belum andal&lt;/b&gt; (4 benar, 4 salah dari 14).&lt;br&gt;• &lt;b&gt;Waktu tunggu:&lt;/b&gt; di company-ai satu gambar dinilai ± 1 detik, jadi paket 5 gambar ± 5 detik sebelum putusan keluar. Angka ini harus diukur sebelum dijanjikan.&lt;br&gt;• ESP32 tidak mengolah video; ia hanya menerima perintah BUKA dari PC lokal di jaringan setempat.&lt;br&gt;• Semua data disimpan (K74). Plat + jam = data pribadi (UU PDP). Sampai Fase 5, relay hanya menyalakan lampu uji." vertex="1">
          <mxGeometry height="150" width="1580" x="30" y="-280" as="geometry" />
        </mxCell>
