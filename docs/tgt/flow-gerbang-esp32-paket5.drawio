  <diagram id="flow-gerbang-paket5" name="Alur gerbang: paket 5 gambar">
    <mxGraphModel dx="6148" dy="5730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="judul" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Alur gerbang CCTV: paket 5 gambar, dinilai PLAT · JENIS · WARNA, gerbang dibuka oleh PC lokal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Satu kamera CCTV 2K, router, PC lokal di pos satpam, server TGT + mesin baca, ESP32 + relay ke motor gerbang&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="1300" x="30" y="-2500" as="geometry" />
        </mxCell>
        <mxCell id="lajur-kamera" parent="1" style="swimlane;startSize=34;fontStyle=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#fafafa;container=0;collapsible=0;" value="Kamera CCTV" vertex="1">
