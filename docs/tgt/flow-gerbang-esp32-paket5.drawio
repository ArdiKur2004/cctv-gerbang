        <mxCell id="p2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Ada&lt;br&gt;kendaraan?" vertex="1">
          <mxGeometry height="100" width="180" x="290" y="-2270" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Ambil 5 gambar berurutan&lt;/b&gt;&lt;br&gt;(± 1 detik antargambar) = 1 paket" vertex="1">
          <mxGeometry height="70" width="220" x="270" y="-2140" as="geometry" />
